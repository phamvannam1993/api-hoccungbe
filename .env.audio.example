# Audio Library Configuration

# Storage Configuration
AUDIO_STORAGE_DISK=local
AUDIO_STORAGE_PATH=audios

# File Upload Limits
AUDIO_MAX_SIZE=52428800  # 50MB in bytes (52428800 = 50 * 1024 * 1024)

# Features
AUDIO_AUTO_DETECT_DURATION=true
AUDIO_SOFT_DELETE=true

# Pagination
AUDIO_DEFAULT_PER_PAGE=15
AUDIO_MAX_PER_PAGE=100

# Database Configuration (example for SQLite)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Database Configuration (example for MySQL)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=audio_library
# DB_USERNAME=root
# DB_PASSWORD=

# Application
APP_NAME="Audio Library API"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
